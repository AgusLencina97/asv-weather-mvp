# Copia este archivo como ".env" (en esta misma carpeta) y completa los valores.
# El archivo .env está en .gitignore y nunca debe subirse al repositorio.

# API key de AEMET OpenData. Se solicita gratis en:
# https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# Credenciales del usuario de la aplicación (solo para desarrollo local)
API_USERNAME=admin
API_PASSWORD=admin123

# Secreto para firmar los JWT (mínimo 32 caracteres). Valor solo para desarrollo local:
# en cualquier otro entorno genera uno aleatorio, por ejemplo con: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
